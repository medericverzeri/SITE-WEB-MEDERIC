# Variables serveur à renseigner dans Vercel > Project > Settings > Environment Variables.
# Cet exemple ne contient aucun secret. Ne publiez jamais les vraies valeurs.

# Obligatoire : connexion PostgreSQL de l’intégration Storage / Marketplace du projet.
DATABASE_URL=

# Obligatoires pour la publication : choisissez un mot de passe robuste et un secret aléatoire long.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Site servi à la racine : encadrant ou developpement.
PRIMARY_SITE_KEY=encadrant

# Optionnel : notification par e-mail. Sans ces valeurs, les messages restent enregistrés dans l’admin.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
